# Copy to deploy/.env and fill in real values: `cp deploy/.env.example deploy/.env`.
# `deploy/.env` is gitignored and is read automatically by `docker compose` when invoked from this
# directory (`cd deploy && docker compose up`). Nothing in this file is a real secret.
#
# A bare `docker compose up` with NO .env at all still works — every var below has a dev-safe
# default baked into deploy/docker-compose.yml. This file exists so you don't have to go read the
# compose file to find out what's tunable, and so the production-required vars are impossible to miss.

# ---------------------------------------------------------------------------------------------------
# REQUIRED for anything beyond a local lab (EYE_ENV != development)
# ---------------------------------------------------------------------------------------------------
# Set this to "production" (or anything other than "development") to turn on the checks below.
# Leaving it at "development" is what makes the zero-config dev flow work; it also means the scope
# guard's signing key and API auth are both allowed to sit on insecure shipped defaults.
# EYE_ENV=production

# HMAC key that signs/verifies engagement scopes. Checked at *module import* time in
# control-plane/app/config.py -- if EYE_ENV != development and this is still the shipped
# "dev-insecure-signing-key", BOTH the api and worker containers crash-loop immediately (before
# uvicorn binds a port), not fail a health check. Generate one with e.g. `openssl rand -hex 32`.
# EYE_SCOPE_SIGNING_KEY=<a long random secret>

# API keys for RBAC, format "key:tenant:role,key:tenant:role,...", role = viewer|operator|admin.
# Checked from the API's startup hook (only `api` builds an Authenticator; `worker` doesn't need
# this var at all). Unset means every request authenticates as a default-tenant admin -- refused
# outright once EYE_ENV != development.
# EYE_API_KEYS=<key>:default:admin

# ---------------------------------------------------------------------------------------------------
# CORS -- must track NEXT_PUBLIC_API_BASE below (they describe the same address pair)
# ---------------------------------------------------------------------------------------------------
# Comma-separated allowlist of browser origins allowed to call the API. Defaults to
# http://localhost:3000, which matches the default NEXT_PUBLIC_API_BASE (http://localhost:9000) for
# pure-loopback dev. If you change NEXT_PUBLIC_API_BASE to a LAN/Tailscale host IP so the UI is
# reachable off-box, the browser's origin becomes http://<host-ip>:3000 and you MUST add it here or
# the UI's requests get rejected by CORS.
# EYE_CORS_ORIGINS=http://localhost:3000,http://<host-ip>:3000

# ---------------------------------------------------------------------------------------------------
# Concurrency / connection budget
# ---------------------------------------------------------------------------------------------------
# In-process pool size for agent/scan runs submitted through the API (per `api` container). Not how
# you scale scan throughput -- see `--scale worker=N` below for that.
# EYE_MAX_CONCURRENT_RUNS=8

# Postgres pool size, per container (api AND every worker replica each open their own). Stock
# postgres:16 allows 100 connections total. Before `docker compose up --scale worker=N`, check that
# (N worker replicas + 1 api) * EYE_PG_POOL_MAX stays comfortably under Postgres's max_connections,
# or lower EYE_PG_POOL_MAX / raise max_connections first.
# EYE_PG_POOL_MIN=2
# EYE_PG_POOL_MAX=32

# ---------------------------------------------------------------------------------------------------
# Sandbox hardening for real targets (see the "deploy checklist" in README.md)
# ---------------------------------------------------------------------------------------------------
# EYE_SANDBOX_RUNTIME=runsc
# EYE_EGRESS_ENFORCER=/usr/local/bin/eye-egress-enforce

# ---------------------------------------------------------------------------------------------------
# LLM provider (Ollama Cloud by default; see README "Connecting an LLM provider" for alternatives)
# ---------------------------------------------------------------------------------------------------
# Required for the pre-wired Ollama Cloud default (get a key at https://ollama.com/settings/keys).
# OLLAMA_API_KEY=<your-ollama-cloud-key>

# ---------------------------------------------------------------------------------------------------
# SAST (Snyk MCP sibling) -- optional, only used if you build+run the mcp-snyk image
# ---------------------------------------------------------------------------------------------------
# SNYK_TOKEN=<your-snyk-token>
# EYE_SRC_ROOT=/samples

# ---------------------------------------------------------------------------------------------------
# Web UI build arg -- NOT read from this file by the api/worker; only affects the `web` build
# ---------------------------------------------------------------------------------------------------
# Baked into the client bundle at build time. For LAN/Tailscale access this must be the host's IP,
# not localhost -- and EYE_CORS_ORIGINS above must then include that same origin.
# NEXT_PUBLIC_API_BASE=http://localhost:9000
